    {
      "id": "adequacy",
      "title": "Specimen Adequacy",
      "fields": [
        {
          "id": "adequacy_status",
          "label": "Adequacy",
          "type": "dropdown",
          "required": true,
          "snomed": "",
          "icd": "",
          "options": [
            {
              "id": "satisfactory",
              "label": "Satisfactory for evaluation",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "unsatisfactory",
              "label": "Unsatisfactory for evaluation",
              "snomed": "",
              "icd": ""
            }
          ]
        },
        {
          "id": "follicular_group_count",
          "label": "Follicular Epithelial Groups Present (approximate count)",
          "type": "text",
          "required": false,
          "note": "Optional (+) — six or more groups of at least 10 well-visualized follicular cells, on at least two slides, is a conventional adequacy benchmark; clinical/radiologic correlation may override in a cystic or clinically concerning nodule",
          "snomed": "",
          "icd": ""
        },
        {
          "id": "unsatisfactory_reason",
          "label": "Reason for Unsatisfactory (if applicable)",
          "type": "checkboxes",
          "required": false,
          "note": "Optional (+)",
          "snomed": "",
          "icd": "",
          "options": [
            {
              "id": "low_cellularity",
              "label": "Insufficient follicular cellularity",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "obscuring_blood",
              "label": "Obscuring blood",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "air_drying",
              "label": "Air-drying / fixation artifact",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "cyst_fluid_only",
              "label": "Cyst fluid only, virtually acellular",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "other",
              "label": "Other (specify)",
              "snomed": "",
              "icd": ""
            }
          ]
        }
      ]
    },
    {
      "id": "diagnostic_category",
