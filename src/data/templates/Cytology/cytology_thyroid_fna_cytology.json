              "icd": ""
            },
            {
              "id": "ii_benign",
              "label": "II — Benign",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "iii_aus_flus",
              "label": "III — Atypia of Undetermined Significance / Follicular Lesion of Undetermined Significance (AUS/FLUS)",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "iv_fn_sfn",
              "label": "IV — Follicular Neoplasm / Suspicious for Follicular Neoplasm (specify if Hürthle cell type)",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "v_suspicious_malignant",
              "label": "V — Suspicious for Malignancy",
              "snomed": "",
              "icd": ""
            },
            {
              "id": "vi_malignant",
              "label": "VI — Malignant",
              "snomed": "",
              "icd": ""
            }
          ]
        },
        {
          "id": "estimated_risk_note",
          "label": "Estimated Risk of Malignancy (reference only, per 3rd Edition ranges)",
          "type": "longtext",
          "required": false,
          "note": "Optional (+) — informational; not a data element to select, a reference note pathologists may cite: I ~13–15%, II ~4–17%, III ~13–30%, IV ~23—35%, V ~67–83%, VI ~97–100%. Ranges reflect the NIFTP reclassification and vary by practice setting — cite local institutional data where available rather than these alone.",
          "snomed": "",
          "icd": ""
        }
      ]
    },
