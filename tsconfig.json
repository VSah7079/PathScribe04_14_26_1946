{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    // Vite bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,

    // React
    "jsx": "react-jsx",

    // Path aliases
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"],
      "@theme/*": ["./src/theme/*"],
      "@app-types/*": ["./src/types/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@contexts/*": ["./src/contexts/*"]
    },

    // Linting
    // Batch 511 (PS-478): full strict type-checking. strictNullChecks found
    // 161 errors and the other strict flags 25; all fixed. Only
    // noImplicitReturns stays off (not part of "strict"; it would flag the
    // ordinary React effect that returns a cleanup in one branch only).
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitReturns": false,

    // Node types
    "types": ["node"]
  },

  "include": ["src", "firestore.rules.test.ts"],

  // Batch 511 (PS-478): nothing is excluded from type-checking any more. The
  // 15 files and one folder listed here before were either deleted (14,
  // now in DELETED_FILES.txt) or have been brought under the check
  // (src/api/caseFlagsApi.ts, src/components/Flags/AutoCreatedBanner.tsx).
  "exclude": ["node_modules"],

  "references": [{ "path": "./tsconfig.node.json" }]
}