<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by scripts/generate-security-headers.mjs from deploy/security-headers/securityHeaders.mjs and this deployment's origins file (Batch 503, PS-474). Edit the origins file and re-run; do not edit this file. -->
<!-- IIS, and Azure App Service on Windows. Merge into the site web.config. -->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://slides-demo.formedrix.ai; font-src 'self' data:; connect-src 'self' https://eutils.ncbi.nlm.nih.gov https://clinicaltables.nlm.nih.gov https://us-central1-formedrixai-pathscribe-14a39.cloudfunctions.net wss://127.0.0.1:9100 https://127.0.0.1:9100 wss://127.0.0.1:9101 https://127.0.0.1:9101 wss://127.0.0.1:9102 https://127.0.0.1:9102 wss://localhost:8181 wss://localhost:8282 wss://localhost:8383 wss://localhost:8484 wss://localhost.qz.io:8181 wss://localhost.qz.io:8282 wss://localhost.qz.io:8383 wss://localhost.qz.io:8484; worker-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Permissions-Policy" value="camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), interest-cohort=()" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
