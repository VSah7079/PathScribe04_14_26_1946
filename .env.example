# PathScribe local settings. Copy to .env and fill in.
#
# Anything starting with VITE_ is copied into the JavaScript every visitor
# downloads, so it must never hold a key or a password (Batch 444;
# src/services/security/envExposure.guard.test.ts).

# ── Safe in the browser (VITE_) ───────────────────────────────────────────
# Optional; an administrator's choice in Configuration → AI overrides these.
# VITE_AI_PROVIDER=structured_messages
# VITE_AI_MODEL=claude-sonnet-4-6
# The QA feedback button and its recipients are set in Configuration →
# System → Feedback (Batch 447); shown by default on a validation instance.
# Optional, low-consequence: raises the public PubMed rate limit only.
# VITE_NCBI_API_KEY=

# Demo sign-in passwords are NOT set here. Set or reset anyone's password in
# Configuration → Staff → edit → Sign-in password (Batch 448).

# ── Server side only (NO VITE_ prefix) ────────────────────────────────────
# Read by the development proxy in vite.config.ts, never by the browser.
# In production the PathScribe API server holds these
# (docs/architecture/AI_PROXY.md).
AI_API_KEY=
GEMINI_API_KEY=
UMLS_API_KEY=
# OpenAI-shaped provider:
# OPENAI_API_KEY=
# Managed (Azure-style) deployment; the route exists only when both are set:
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=
# Custom OpenAI-compatible endpoint; the route exists only when set:
# CUSTOM_AI_ENDPOINT=https://my-llm.hospital.internal/v1
# CUSTOM_AI_API_KEY=
