/* ============================================================
   RESPONSIVE NAVBAR STYLING (Premium Black + Gold Theme)
   ============================================================ */

/* Navbar Container */
.ps-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 40px;
  background: rgba(15, 23, 42, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(245, 158, 11, 0.1);
  gap: 20px;
  flex-wrap: wrap;
  min-height: 70px;
  height: auto;
}

/* Left Section */
.ps-nav-left {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

.ps-nav-logo {
  height: 32px;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.ps-nav-logo:hover {
  transform: scale(1.05);
}

.ps-nav-divider {
  width: 1px;
  height: 28px;
  background: rgba(245, 158, 11, 0.2);
}

/* Navigation Links Section */
.ps-nav-center {
  display: flex;
  align-items: center;
  gap: 20px;
  flex: 1;
  justify-content: center;
}

.ps-nav-links {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}

/* Individual Link Chips */
.ps-nav-link-chip {
  padding: 8px 18px;
  border: 1.5px solid rgba(245, 158, 11, 0.3);
  background: rgba(245, 158, 11, 0.05);
  color: #e2e8f0;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
}

.ps-nav-link-chip:hover {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  color: #fcd34d;
  box-shadow: 0 4px 20px rgba(245, 158, 11, 0.25);
  transform: translateY(-2px);
}

.ps-nav-link-chip:active {
  background: rgba(245, 158, 11, 0.2);
  transform: translateY(0);
}

/* Search Bar in Navbar */
.ps-nav-case-search-slot {
  flex: 1;
  min-width: 200px;
  max-width: 400px;
}

.ps-case-search-input {
  background: rgba(0, 0, 0, 0.3) !important;
  border: 1.5px solid rgba(245, 158, 11, 0.2) !important;
  color: #f8fafc !important;
  border-radius: 10px !important;
  padding: 10px 40px 10px 40px !important;
  transition: all 0.3s ease !important;
}

.ps-case-search-input:focus {
  border-color: #f59e0b !important;
  box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15) !important;
  background: rgba(0, 0, 0, 0.5) !important;
}

.ps-case-search-input::placeholder {
  color: #64748b !important;
}

/* Right Section */
.ps-nav-right {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

.ps-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background: transparent;
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.3s ease;
  color: #94a3b8;
}

.ps-nav-btn:hover {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.1);
  color: #fcd34d;
}

.ps-nav-user {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  padding: 6px 14px;
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 10px;
  transition: all 0.3s ease;
}

.ps-nav-user:hover {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.05);
}

.ps-nav-user-meta {
  text-align: right;
}

.ps-nav-avatar {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: linear-gradient(135deg, #f59e0b, #fcd34d);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #0f172a;
}

.ps-nav-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  background: #FF453A;
  color: white;
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 6px;
}

/* ============================================================
   RESPONSIVE BREAKPOINTS
   ============================================================ */

/* Tablet Landscape (1024px - 1399px) */
@media (max-width: 1400px) {
  .ps-nav {
    padding: 12px 30px;
    gap: 16px;
  }

  .ps-nav-center {
    gap: 16px;
  }

  .ps-nav-links {
    gap: 6px;
  }

  .ps-nav-link-chip {
    padding: 7px 14px;
    font-size: 12px;
  }

  .ps-nav-case-search-slot {
    max-width: 350px;
  }
}

/* Tablet Portrait (768px - 1023px) */
@media (max-width: 1024px) {
  .ps-nav {
    min-height: auto;
    flex-wrap: wrap;
    padding: 10px 20px;
    height: auto;
    gap: 12px;
    justify-content: flex-start;
  }

  .ps-nav-left {
    width: 100%;
    gap: 12px;
    margin-bottom: 4px;
  }

  .ps-nav-center {
    order: 3;
    width: 100%;
    margin: 8px 0;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-start;
  }

  .ps-nav-links {
    width: 100%;
    gap: 6px;
    justify-content: flex-start;
  }

  .ps-nav-link-chip {
    padding: 6px 12px;
    font-size: 11px;
    flex: 0 1 auto;
  }

  .ps-nav-case-search-slot {
    flex: 1;
    min-width: 180px;
    max-width: 100%;
  }

  .ps-nav-right {
    width: 100%;
    gap: 10px;
    margin-top: 4px;
    justify-content: flex-start;
  }

  .ps-nav-logo {
    height: 28px;
  }

  .ps-nav-btn {
    width: 38px;
    height: 38px;
    font-size: 16px;
  }
}

/* Mobile Landscape (640px - 767px) */
@media (max-width: 768px) {
  .ps-nav {
    min-height: auto;
    height: auto;
    padding: 10px 16px;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
    align-items: stretch;
  }

  .ps-nav-left {
    width: 100%;
    gap: 10px;
    justify-content: flex-start;
  }

  .ps-nav-logo {
    height: 26px;
    max-width: 120px;
  }

  .ps-nav-enhancement {
    display: none;
  }

  .ps-nav-center {
    order: 3;
    width: 100%;
    margin: 4px 0;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }

  .ps-nav-links {
    width: 100%;
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ps-nav-link-chip {
    flex: 0 1 calc(50% - 3px);
    padding: 7px 10px;
    font-size: 11px;
    text-align: center;
  }

  .ps-nav-case-search-slot {
    width: 100%;
    max-width: 100%;
  }

  .ps-case-search-input {
    padding: 9px 36px 9px 36px !important;
    font-size: 13px !important;
  }

  .ps-nav-right {
    width: 100%;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ps-nav-user-meta {
    display: none;
  }

  .ps-nav-divider {
    display: none;
  }

  .ps-nav-btn {
    width: 40px;
    height: 40px;
  }

  .ps-nav-avatar {
    width: 36px;
    height: 36px;
  }
}

/* Mobile (480px - 639px) */
@media (max-width: 640px) {
  .ps-nav {
    padding: 8px 12px;
    gap: 8px;
  }

  .ps-nav-left {
    gap: 8px;
  }

  .ps-nav-logo {
    height: 24px;
    max-width: 100px;
  }

  .ps-nav-links {
    gap: 4px;
  }

  .ps-nav-link-chip {
    flex: 0 1 calc(50% - 2px);
    padding: 6px 8px;
    font-size: 10px;
  }

  .ps-nav-case-search-slot {
    width: 100%;
  }

  .ps-case-search-input {
    padding: 8px 32px 8px 32px !important;
    font-size: 12px !important;
  }

  .ps-nav-btn {
    width: 36px;
    height: 36px;
    font-size: 14px;
  }

  .ps-nav-avatar {
    width: 32px;
    height: 32px;
    font-size: 11px;
  }

  .ps-nav-right {
    gap: 6px;
  }
}

/* Extra Small Mobile (< 480px) */
@media (max-width: 480px) {
  .ps-nav {
    padding: 8px 10px;
    gap: 8px;
  }

  .ps-nav-left {
    gap: 6px;
  }

  .ps-nav-logo {
    height: 22px;
  }

  .ps-nav-center {
    gap: 6px;
  }

  .ps-nav-links {
    gap: 4px;
    justify-content: center;
  }

  .ps-nav-link-chip {
    flex: 1 1 calc(33.333% - 3px);
    padding: 5px 6px;
    font-size: 9px;
    border-radius: 6px;
  }

  .ps-nav-case-search-slot {
    width: 100%;
  }

  .ps-case-search-input {
    padding: 8px 28px 8px 28px !important;
    font-size: 11px !important;
  }

  .ps-nav-right {
    width: 100%;
    gap: 4px;
    justify-content: center;
  }

  .ps-nav-btn {
    width: 34px;
    height: 34px;
    font-size: 13px;
  }

  .ps-nav-user-meta {
    display: none;
  }

  .ps-nav-divider {
    display: none;
  }
}
