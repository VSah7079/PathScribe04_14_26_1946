            {cards.map((card, index) => (
              <div
                key={card.title}
                onClick={() => navigate(card.route)}
                onMouseEnter={() => setHoveredCard(index)}
                onMouseLeave={() => setHoveredCard(null)}
                className={`relative cursor-pointer overflow-hidden rounded-2xl bg-slate-800 border h-60 transition-all duration-400 group ${
                  hoveredCard === index 
                    ? 'border-amber-500 shadow-2xl scale-105 -translate-y-3' 
                    : 'border-slate-700 shadow-lg'
                }`}
              >
                {/* Accent Line */}
                <div 
