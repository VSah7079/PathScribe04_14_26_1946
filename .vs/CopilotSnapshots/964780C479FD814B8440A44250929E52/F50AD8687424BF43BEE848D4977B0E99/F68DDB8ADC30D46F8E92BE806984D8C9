import { useEffect, useState } from "react";
import SunCalc from "suncalc";
import { useNavigate } from "react-router-dom";
import { useAuth } from "@contexts/AuthContext";

type ThemeMode = "light" | "dark" | "auto" | "scheduled";

export default function Home() {
  const navigate = useNavigate();
  const { user } = useAuth();

  const [theme, setTheme] = useState<ThemeMode>("auto");
  const [resolvedTheme, setResolvedTheme] = useState<"light" | "dark">("light");
  const [pauseAnimation, setPauseAnimation] = useState(false);
  const [themeNotice, setThemeNotice] = useState("");
  const [showAbout, setShowAbout] = useState(false);

  const isAdmin = user?.roles?.includes("SystemAdmin");
  const isPathologist = user?.roles?.includes("Pathologist");

  useEffect(() => {
    const saved = localStorage.getItem("theme-mode") as ThemeMode | null;
    if (saved) setTheme(saved);
  }, []);

  useEffect(() => {
    localStorage.setItem("theme-mode", theme);
  }, [theme]);

  useEffect(() => {
    const applyTheme = () => {
      if (theme === "light") return setResolvedTheme("light");
      if (theme === "dark") return setResolvedTheme("dark");

      if (theme === "auto") {
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        return setResolvedTheme(prefersDark ? "dark" : "light");
      }

      if (theme === "scheduled") {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const { latitude, longitude } = pos.coords;
            const times = SunCalc.getTimes(new Date(), latitude, longitude);
            const now = new Date();
            const isNight = now < times.sunrise || now > times.sunset;
            setResolvedTheme(isNight ? "dark" : "light");
            setThemeNotice("");
          },
          () => {
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            setResolvedTheme(prefersDark ? "dark" : "light");
            setThemeNotice(
              "We couldn't determine your location, so we're using your system theme."
            );
          }
        );
      }
    };

    applyTheme();
  }, [theme]);

  const isDark = resolvedTheme === "dark";

  const watermarkOpacity = pauseAnimation ? 0.06 : isDark ? 0.12 : 0.14;
  const watermarkBrightness = pauseAnimation
    ? "brightness(120%)"
    : isDark
    ? "brightness(180%)"
    : "brightness(240%)";

  const logoSrc = isDark ? "/pathscribe-logo-dark.svg" : "/pathscribe-logo.svg";

  const Tile = ({
    title,
    subtitle,
    image,
    onClick,
  }: {
    title: string;
    subtitle?: string;
    image: string;
    onClick: () => void;
  }) => (
    <div
      onClick={onClick}
      className={`relative h-52 rounded-2xl overflow-hidden cursor-pointer bg-cover bg-center border transition-all duration-300 hover:scale-105 hover:shadow-xl ${
        isDark
          ? 'border-white/20 shadow-lg shadow-black/35 hover:border-white/35'
          : 'border-white/20 shadow-lg shadow-black/35 hover:border-white/35'
      }`}
      style={{
        backgroundImage: `url(${image})`,
      }}
    >
      <div className="absolute inset-0 bg-gradient-to-t from-black/55 to-black/15" />
      <div className="absolute bottom-4 left-4 text-white" style={{ textShadow: '0 2px 6px rgba(0,0,0,0.45)' }}>
        <div className="text-xl font-bold">{title}</div>
        {subtitle && <div className="text-sm opacity-85">{subtitle}</div>}
      </div>
    </div>
  );

  return (
    <div
      className={`h-screen w-screen flex relative ${
        isDark
          ? 'bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-gray-200'
          : 'bg-gradient-to-br from-indigo-50 to-slate-100 text-slate-900'
      }`}
    >
      <div
        className="flex-1 relative overflow-hidden bg-cover bg-center"
        style={{
          backgroundImage: `url('/main_background.jpg')`,
          transform: 'scale(1.06)',
        }}
      >
        <div
          className={`absolute inset-0 ${
            isDark
              ? 'bg-gradient-to-br from-white/18 to-white/6'
              : 'bg-gradient-to-br from-black/28 to-black/10'
          }`}
        />

        <div
          className={`absolute inset-0`}
          style={{
            backgroundImage: isDark
              ? 'radial-gradient(circle at center, transparent 60%, rgba(0,0,0,0.35))'
              : 'radial-gradient(circle at center, transparent 60%, rgba(0,0,0,0.22))',
          }}
        />

        <img
          src={logoSrc}
          alt="Watermark"
          className={`absolute top-1/2 left-1/2 w-36 h-36 -translate-x-1/2 -translate-y-1/2 transition-all duration-300 ${
            pauseAnimation ? '' : 'animate-spin'
          }`}
          style={{
            opacity: watermarkOpacity,
            filter: watermarkBrightness,
            animation: pauseAnimation ? 'none' : 'spin 20s linear infinite',
          }}
        />
      </div>

      <div className="w-96 px-10 py-16 flex flex-col justify-center gap-6">
        <img
          src={logoSrc}
          alt="PathScribe AI"
          className="w-52 block mx-auto mb-4"
        />

        <div className="grid grid-cols-1 gap-5">
          <Tile
            title="Performance"
            subtitle="System metrics and throughput"
            image="/performance.jpg"
            onClick={() => navigate("/admin/performance")}
          />

          <Tile
            title="Models"
            subtitle="AI model management"
            image="/models.jpg"
            onClick={() => navigate("/admin/models")}
          />

          {isPathologist && (
            <Tile
              title="My Cases"
              subtitle="Assigned worklist and active reviews"
              image="/worklist.jpg"
              onClick={() => navigate("/pathologist/worklist")}
            />
          )}

          {isAdmin && (
            <Tile
              title="Training Data"
              subtitle="Dataset management"
              image="/training.jpg"
              onClick={() => navigate("/admin/training-data")}
            />
          )}

          {isAdmin && (
            <Tile
              title="Audit Logs"
              subtitle="System activity and access logs"
              image="/logs.jpg"
              onClick={() => navigate("/admin/audit-logs")}
            />
          )}

          {isAdmin && (
            <Tile
              title="System Configuration"
              subtitle="Environment, licensing, and settings"
              image="/config.jpg"
              onClick={() => navigate("/admin/configuration")}
            />
          )}
        </div>
      </div>

      <div className="absolute top-5 right-5 flex gap-2 items-center z-20">
        <button
          onClick={() => setTheme("light")}
          className={`w-7 h-7 rounded-full border backdrop-blur-sm cursor-pointer transition-all duration-200 flex items-center justify-center ${
            isDark
              ? 'border-white/25 bg-black/6 hover:border-white/35 hover:bg-black/12'
              : 'border-black/25 bg-white/20 hover:border-black/35 hover:bg-white/30'
          }`}
          title="Light theme"
        >
          ☀️
        </button>

        <button
          onClick={() => setTheme("dark")}
          className={`w-7 h-7 rounded-full border backdrop-blur-sm cursor-pointer transition-all duration-200 flex items-center justify-center ${
            isDark
              ? 'border-white/25 bg-black/6 hover:border-white/35 hover:bg-black/12'
              : 'border-black/25 bg-white/20 hover:border-black/35 hover:bg-white/30'
          }`}
          title="Dark theme"
        >
          🌙
        </button>

        <button
          onClick={() => setTheme("auto")}
          className={`w-7 h-7 rounded-full border backdrop-blur-sm cursor-pointer transition-all duration-200 flex items-center justify-center ${
            isDark
              ? 'border-white/25 bg-black/6 hover:border-white/35 hover:bg-black/12'
              : 'border-black/25 bg-white/20 hover:border-black/35 hover:bg-white/30'
          }`}
          title="Auto theme"
        >
          ⚙️
        </button>

        <button
          onClick={() => setShowAbout(true)}
          className={`w-7 h-7 rounded-full border backdrop-blur-sm cursor-pointer font-semibold transition-all duration-200 flex items-center justify-center ${
            isDark
              ? 'border-white/25 bg-black/6 hover:border-white/35 hover:bg-black/12'
              : 'border-black/25 bg-white/20 hover:border-black/35 hover:bg-white/30'
          }`}
          title="About"
        >
          ?
        </button>
      </div>

      {showAbout && (
        <div
          onClick={() => setShowAbout(false)}
          className={`fixed inset-0 backdrop-blur-sm flex items-center justify-center z-50 ${
            isDark ? 'bg-black/55' : 'bg-black/35'
          }`}
        >
          <div
            onClick={(e) => e.stopPropagation()}
            className={`w-96 p-7 rounded-2xl border backdrop-blur-lg shadow-2xl ${
              isDark
                ? 'bg-slate-900/55 border-white/22'
                : 'bg-white/55 border-black/18'
            }`}
          >
            <h2 className="mt-0 mb-3 text-xl font-bold">PathScribe AI</h2>
            <p className="my-1 text-sm">Version 0.9.0</p>
            <p className="my-1 text-sm">Build: 20260211</p>
            <p className="my-1 text-sm">Environment: Internal Preview</p>

            <div
              className={`h-px my-4 ${
                isDark ? 'bg-white/15' : 'bg-black/15'
              }`}
            />

            <p className="my-1 text-sm">Developed by the PathScribe AI Team</p>
            <p className="my-1 text-sm">© 2026 PathScribe</p>

            {themeNotice && (
              <p className="mt-2 mb-0 text-xs opacity-80">{themeNotice}</p>
            )}

            <button
              onClick={() => setShowAbout(false)}
              className={`mt-5 w-full py-2.5 rounded-lg font-semibold cursor-pointer transition-all duration-200 ${
                isDark
                  ? 'bg-white/12 hover:bg-white/18 text-white'
                  : 'bg-black/12 hover:bg-black/18 text-black'
              }`}
            >
              Close
            </button>
          </div>
        </div>
      )}

      <style>{`
        @keyframes spin {
          from { transform: translate(-50%, -50%) rotate(0deg); }
          to { transform: translate(-50%, -50%) rotate(360deg); }
        }
      `}</style>
    </div>
  );
}
